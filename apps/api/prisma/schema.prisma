generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  VIEWER
  CREATOR
  ADMIN
}

enum KycStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum StreamStatus {
  LIVE
  ENDED
}

enum Currency {
  COIN
  DIAMOND
}

enum LedgerKind {
  COIN_PURCHASE
  GIFT_SENT
  GIFT_RECEIVED
  PAYOUT
  ADJUSTMENT
  DEV_TOPUP
  SIGNUP_GRANT
  CONTENT_PURCHASE
  CONTENT_SALE
  SUBSCRIPTION_CHARGE
  SUBSCRIPTION_EARNING
  CONTENT_REFUND
  CONTENT_CLAWBACK
}

model User {
  ageSource       String?
  realName        String?
  ageDeclaredAt   DateTime?
  suspendedAt     DateTime?
  suspendReason   String?
  id              String          @id @default(uuid())
  googleId        String          @unique
  email           String          @unique
  name            String
  avatarUrl       String?
  country         String? 
  role            Role            @default(VIEWER)
  ageVerified     Boolean         @default(false)
  createdAt       DateTime        @default(now())
  wallet          Wallet?
  creator         CreatorProfile?
  streams         Stream[]
  rulesVersion    Int?
  rulesAcceptedAt DateTime?
}

model CreatorProfile {
  lastNotifiedAt DateTime?
  id             String    @id @default(uuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id])
  username       String    @unique
  bio            String?
  kycStatus      KycStatus @default(NONE)
  enabledTiers   Int[]     @default([1, 2, 3])
}

model Stream {
  slowModeSeconds Int           @default(0)
  id              String        @id @default(uuid())
  creatorId       String
  creator         User          @relation(fields: [creatorId], references: [id])
  title           String
  roomName        String        @unique
  status          StreamStatus  @default(LIVE)
  startedAt       DateTime      @default(now())
  endedAt         DateTime?
  ledger          LedgerEntry[]

  category String?
  tags     String[] @default([])

  @@index([status, startedAt, category])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String // live | friend | chat
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([type, createdAt])
}

model Gift {
  emoji        String  @default("🎁")
  id           String  @id @default(uuid())
  name         String  @unique
  coinPrice    Int
  animationUrl String?
}

model Wallet {
  id             String        @id @default(uuid())
  userId         String        @unique
  user           User          @relation(fields: [userId], references: [id])
  coinBalance    Int           @default(0)
  diamondBalance Int           @default(0)
  entries        LedgerEntry[]
}

// Append-only ledger. Never update or delete rows.
model LedgerEntry {
  counterpartyUserId String?
  id                 String     @id @default(uuid())
  walletId           String
  wallet             Wallet     @relation(fields: [walletId], references: [id])
  currency           Currency
  amount             Int
  kind               LedgerKind
  idempotencyKey     String     @unique
  streamId           String?
  stream             Stream?    @relation(fields: [streamId], references: [id])
  giftId             String?
  createdAt          DateTime   @default(now())

  @@index([walletId, createdAt])
}

enum RestrictionKind {
  MUTED
  KICKED
}

enum ReportStatus {
  OPEN
  RESOLVED
}

model StreamRestriction {
  id        String          @id @default(uuid())
  streamId  String
  userId    String
  kind      RestrictionKind
  createdAt DateTime        @default(now())

  @@unique([streamId, userId])
}

model ChatMessage {
  id        String   @id @default(uuid())
  streamId  String
  userId    String
  text      String
  createdAt DateTime @default(now())

  @@index([streamId, userId, createdAt])
}

model Report {
  id           String       @id @default(uuid())
  reporterId   String
  targetUserId String
  streamId     String?
  messageId    String?
  reason       String
  details      String?
  status       ReportStatus @default(OPEN)
  createdAt    DateTime     @default(now())

  mediaId    String?
  resolution String?
  adminNote  String?
  resolvedBy String?
  resolvedAt DateTime?

  @@index([status, createdAt])
  @@index([mediaId, status])
  @@index([reporterId, createdAt])
}

enum PayoutStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

// Fake money for now: "destination" is a free-text label. Do not store real bank details.
model PayoutRequest {
  id          String       @id @default(uuid())
  userId      String
  diamonds    Int
  amountCents Int
  method      String
  destination String
  status      PayoutStatus @default(PENDING)
  adminNote   String?
  createdAt   DateTime     @default(now())
  processedAt DateTime?
  processedBy String?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model AdminAction {
  id         String   @id @default(uuid())
  adminId    String
  action     String
  targetType String
  targetId   String
  note       String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model CreatorApplication {
  id         String            @id @default(uuid())
  userId     String
  username   String
  bio        String?
  status     ApplicationStatus @default(PENDING)
  adminNote  String?
  createdAt  DateTime          @default(now())
  reviewedAt DateTime?
  reviewedBy String?

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model Follow {
  id         String   @id @default(uuid())
  followerId String
  creatorId  String
  createdAt  DateTime @default(now())
  muteLive   Boolean  @default(false)

  @@unique([followerId, creatorId])
  @@index([creatorId])
}

model PushToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum FriendStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

model Friendship {
  id          String       @id @default(uuid())
  requesterId String
  addresseeId String
  status      FriendStatus @default(PENDING)
  createdAt   DateTime     @default(now())

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

model DirectMessage {
  id           String    @id @default(uuid())
  friendshipId String
  senderId     String
  text         String
  createdAt    DateTime  @default(now())
  readAt       DateTime?

  @@index([friendshipId, createdAt])
}

model MediaItem {
  id          String   @id @default(uuid())
  creatorId   String
  type        String // IMAGE | VIDEO
  r2Key       String
  previewKey  String?
  title       String
  priceCoins  Int? // null = not sold individually
  minTier     Int? // null = no subscriber access, 1-3 = lowest tier with access
  durationSec Int?
  status      String   @default("PENDING") // PENDING | APPROVED | REMOVED
  createdAt   DateTime @default(now())

  @@index([creatorId, createdAt])
}

model MediaPurchase {
  id        String   @id @default(uuid())
  userId    String
  mediaId   String
  coinsPaid Int
  createdAt DateTime @default(now())

  @@unique([userId, mediaId])
}

model Subscription {
  id               String   @id @default(uuid())
  subscriberId     String
  creatorId        String
  tier             Int // 1 = 10K, 2 = 25K, 3 = 50K
  nextTier         Int?
  status           String   @default("ACTIVE") // ACTIVE | CANCELLED | EXPIRED
  currentPeriodEnd DateTime
  createdAt        DateTime @default(now())

  @@unique([subscriberId, creatorId])
  @@index([status, currentPeriodEnd])
}

enum RefundStatus {
  PENDING
  APPROVED
  DENIED
}

model RefundRequest {
  id               String       @id @default(uuid())
  purchaseId       String       @unique
  userId           String
  mediaId          String
  creatorId        String
  coins            Int
  source           String // CREATOR_REMOVED | ADMIN_REMOVED
  reason           String?
  status           RefundStatus @default(PENDING)
  rootCause        String?
  adminNote        String?
  clawbackDiamonds Int          @default(0)
  createdAt        DateTime     @default(now())
  decidedAt        DateTime?
  decidedBy        String?

  @@index([status, createdAt])
  @@index([mediaId, status])
  @@index([userId, createdAt])
}
