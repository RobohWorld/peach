generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  VIEWER
  CREATOR
  ADMIN
}

enum KycStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum StreamStatus {
  LIVE
  ENDED
}

enum Currency {
  COIN
  DIAMOND
}

enum LedgerKind {
  COIN_PURCHASE
  GIFT_SENT
  GIFT_RECEIVED
  PAYOUT
  ADJUSTMENT
  DEV_TOPUP
}

model User {
  ageDeclaredAt DateTime?
  suspendedAt   DateTime?
  suspendReason String?
  id            String          @id @default(uuid())
  googleId      String          @unique
  email         String          @unique
  name          String
  avatarUrl     String?
  role          Role            @default(VIEWER)
  ageVerified   Boolean         @default(false)
  createdAt     DateTime        @default(now())
  wallet        Wallet?
  creator       CreatorProfile?
  streams       Stream[]
}

model CreatorProfile {
  lastNotifiedAt DateTime?
  id             String    @id @default(uuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id])
  username       String    @unique
  bio            String?
  kycStatus      KycStatus @default(NONE)
}

model Stream {
  slowModeSeconds Int           @default(0)
  id              String        @id @default(uuid())
  creatorId       String
  creator         User          @relation(fields: [creatorId], references: [id])
  title           String
  roomName        String        @unique
  status          StreamStatus  @default(LIVE)
  startedAt       DateTime      @default(now())
  endedAt         DateTime?
  ledger          LedgerEntry[]

  @@index([status, startedAt])
}

model Gift {
  emoji        String  @default("🎁")
  id           String  @id @default(uuid())
  name         String  @unique
  coinPrice    Int
  animationUrl String?
}

model Wallet {
  id             String        @id @default(uuid())
  userId         String        @unique
  user           User          @relation(fields: [userId], references: [id])
  coinBalance    Int           @default(0)
  diamondBalance Int           @default(0)
  entries        LedgerEntry[]
}

// Append-only ledger. Never update or delete rows.
model LedgerEntry {
  counterpartyUserId String?
  id                 String     @id @default(uuid())
  walletId           String
  wallet             Wallet     @relation(fields: [walletId], references: [id])
  currency           Currency
  amount             Int
  kind               LedgerKind
  idempotencyKey     String     @unique
  streamId           String?
  stream             Stream?    @relation(fields: [streamId], references: [id])
  giftId             String?
  createdAt          DateTime   @default(now())

  @@index([walletId, createdAt])
}

enum RestrictionKind {
  MUTED
  KICKED
}

enum ReportStatus {
  OPEN
  RESOLVED
}

model StreamRestriction {
  id        String          @id @default(uuid())
  streamId  String
  userId    String
  kind      RestrictionKind
  createdAt DateTime        @default(now())

  @@unique([streamId, userId])
}

model ChatMessage {
  id        String   @id @default(uuid())
  streamId  String
  userId    String
  text      String
  createdAt DateTime @default(now())

  @@index([streamId, userId, createdAt])
}

model Report {
  id           String       @id @default(uuid())
  reporterId   String
  targetUserId String
  streamId     String?
  messageId    String?
  reason       String
  details      String?
  status       ReportStatus @default(OPEN)
  createdAt    DateTime     @default(now())

  @@index([status, createdAt])
}

enum PayoutStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

// Fake money for now: "destination" is a free-text label. Do not store real bank details.
model PayoutRequest {
  id          String       @id @default(uuid())
  userId      String
  diamonds    Int
  amountCents Int
  method      String
  destination String
  status      PayoutStatus @default(PENDING)
  adminNote   String?
  createdAt   DateTime     @default(now())
  processedAt DateTime?
  processedBy String?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model AdminAction {
  id         String   @id @default(uuid())
  adminId    String
  action     String
  targetType String
  targetId   String
  note       String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model CreatorApplication {
  id         String            @id @default(uuid())
  userId     String
  username   String
  bio        String?
  status     ApplicationStatus @default(PENDING)
  adminNote  String?
  createdAt  DateTime          @default(now())
  reviewedAt DateTime?
  reviewedBy String?

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model Follow {
  id         String   @id @default(uuid())
  followerId String
  creatorId  String
  createdAt  DateTime @default(now())

  @@unique([followerId, creatorId])
  @@index([creatorId])
}

model PushToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
